# Copy to .env for local development.
DATABASE_URL="postgresql://tactyqal:tactyqal@localhost:5433/tactyqal_dev"
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"
# Bearer token required for write endpoints (create/update/delete posts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN="change-me-to-a-long-random-string"
LOG_LEVEL=info
# Trust X-Forwarded-For only from this host (the web app forwards visitor IPs).
TRUST_PROXY=loopback
