# Server-side only. Every API call goes through Server Components or Server Actions.
API_URL="http://localhost:4000/api/v1"
# Public origin of this site, used for canonical URLs, sitemap and Open Graph tags.
SITE_URL="http://localhost:3000"
# Optional. Must match the API's INTERNAL_API_SECRET when the two run on
# different hosts, so the API rate-limits per visitor rather than per server.
# INTERNAL_API_SECRET="another-long-random-string"
